{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project (Compile Java)",
            "type": "shell",
            "command": "javac",
            "args": [
                "-cp",
                "lib/*;src",
                "-d",
                "bin",
                "src/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "Start Web Server",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "lib/*;bin;src",
                "Main"
            ],
            "dependsOn": "Build Project (Compile Java)",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Start Swing Desktop Application",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "lib/*;bin;src",
                "Main",
                "--swing"
            ],
            "dependsOn": "Build Project (Compile Java)",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Run OOP Validation Tests",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "lib/*;bin;src",
                "Main",
                "--test"
            ],
            "dependsOn": "Build Project (Compile Java)",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
